# Template for wx-bot systemd. Review paths and permissions before installation.
# This prototype uses root for convenience; do not expose local API publicly.
[Unit]
Description=wx-bot WeChat iLink bridge (pull delivery)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Environment=HOME=/home/USER
WorkingDirectory=/home/USER
EnvironmentFile=-/home/USER/.config/wx-bot/env
ExecStart=/home/USER/.local/bin/wx-bot --config /home/USER/.config/wx-bot/config.json run
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/USER/.local/state/wx-bot /home/USER/.config/wx-bot

[Install]
WantedBy=default.target
